<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyName>GoodbyeDPI-Turkey</AssemblyName>
    <RootNamespace>GoodbyeDpiApp</RootNamespace>
    <Product>GoodbyeDPI Türkiye</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Debug builds run without elevation so the UI can be inspected; Release always asks for admin. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Carries the .NET runtime so the exe runs on machines without .NET installed. -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile Condition="'$(SelfContained)' == 'true'">true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\x86_64\*" LogicalName="bin/x86_64/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\x86\*" LogicalName="bin/x86/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\licenses\*" LogicalName="licenses/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
